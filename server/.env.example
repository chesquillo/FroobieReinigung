# Base de datos (SQLite en local). En la nube: postgresql://usuario:pass@host:5432/froobie
DATABASE_URL="file:./froobie.db"
# Secreto para firmar sesiones: cámbialo por una cadena larga y aleatoria
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# Contraseña inicial del administrador (solo se usa al ejecutar el seed)
ADMIN_USERNAME="froobieadmin"
ADMIN_INITIAL_PASSWORD="cambia-esta-contraseña"
ADMIN_EMAIL="admin@froobie.local"
# Zona horaria de la fábrica (determina qué día es "hoy")
APP_TIMEZONE="Europe/Berlin"
PORT=3000
# URL pública que irá dentro de los QR (p.ej. http://192.168.1.50:3000 o https://froobie.tudominio.com)
PUBLIC_URL="http://localhost:5173"
# Solo pruebas: forzar la fecha de "hoy" (YYYY-MM-DD). Déjalo vacío en producción.
FAKE_TODAY=""

# ---- Supabase (opcional en local, necesario en la nube) ----
# Fotos en Supabase Storage (bucket privado que la app crea sola)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="froobie-photos"
